# Configuration file for Doxygen

PROJECT_NAME           = PersonalDashboard
PROJECT_BRIEF          = Platform building user dashboards in MediaWiki

OUTPUT_DIRECTORY       = docs
HTML_OUTPUT            = php

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = NO
WARN_NO_PARAMDOC       = NO

INPUT                  = README.md docs .
EXCLUDE                = vendor node_modules tests docs/php
FILE_PATTERNS          = *.php *.md
RECURSIVE              = YES
# Requires doxygen 1.8.3+
USE_MDFILE_AS_MAINPAGE = README.md

HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250

GENERATE_LATEX         = NO

HAVE_DOT               = YES
DOT_FONTNAME           = Helvetica
DOT_FONTSIZE           = 10
TEMPLATE_RELATIONS     = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
# Makes dot run faster. Requires graphviz >1.8.10
DOT_MULTI_TARGETS      = YES
