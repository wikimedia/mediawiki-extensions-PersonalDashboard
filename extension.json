					"groups": [
						{
							"name": "main",
							"enabled": true,
							"subgroups": [
								{
									"name": "primary",
									"enabled": true,
									"modules": [
										{
											"name": "ext.personalDashboard.reviewChanges",
											"enabled": true
										},
										{
											"name": "ext.personalDashboard.returnToHomepage",
