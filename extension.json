{
	"name": "PersonalDashboard",
	"author": [
		"[https://www.mediawiki.org/wiki/Moderator_Tools#The_team Moderator Tools Team]",
		"[https://www.mediawiki.org/wiki/Growth/Team WMF Growth Team]"
	],
	"url": "https://www.mediawiki.org/wiki/Special:MyLanguage/Extension:PersonalDashboard",
	"descriptionmsg": "personal-dashboard-desc",
	"license-name": "GPL-3.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.48.0",
		"extensions": {
			"CommunityConfiguration": "*"
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\PersonalDashboard\\": "src/"
	},
	"TestAutoloadNamespaces": {
		"MediaWiki\\Extension\\PersonalDashboard\\Tests\\Integration\\": "tests/phpunit/integration/",
		"MediaWiki\\Extension\\PersonalDashboard\\Tests\\Unit\\": "tests/phpunit/unit/"
	},
	"RestModuleFiles": [
		"src/Rest/personaldashboard.v0.json"
	],
	"ServiceWiringFiles": [
		"ServiceWiring.php"
	],
	"ConfigRegistry": {
		"PersonalDashboard": "MediaWiki\\Config\\GlobalVarConfig::newInstance"
	},
	"HookHandlers": {
		"modules": {
			"class": "MediaWiki\\Extension\\PersonalDashboard\\HookHandler\\ResourceLoaderRegisterModulesHandler"
		}
	},
	"Hooks": {
		"ResourceLoaderRegisterModules": "modules"
	},
	"MessagesDirs": {
		"PersonalDashboard": [
			"i18n/api",
			"i18n/ext.personalDashboard.common",
			"i18n/main"
		]
	},
	"ResourceModules": {
		"ext.personalDashboard.special": {
			"localBasePath": "resources/ext.personalDashboard.special",
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"codexComponents": [
				"CdxButton",
				"CdxDialog",
				"CdxIcon"
			],
			"packageFiles": [
				"init.js",
				"App.vue",
				"Dashboard.vue",
				"FocusedFrame.vue",
				"FocusedHeader.vue",
				"IslandMount.vue",
				"ModuleDialog.vue",
				"mediaWikiHistory.js",
				"teleportTargets.js",
				"instrumentation/onPersonalDashboardBaseline.js",
				"../ext.personalDashboard.common/stats.js",
				{
					"name": "icons.json",
					"callback": "MediaWiki\\ResourceLoader\\CodexModule::getIcons",
					"callbackParam": [
						"cdxIconArrowPrevious"
					]
				}
			],
			"dependencies": [
				"vue",
				"personaldashboard-vue-router",
				"ext.personalDashboard.common"
			],
			"messages": [
				"personal-dashboard-back-to-dashboard"
			]
		},
		"ext.personalDashboard.common": {
			"localBasePath": "resources/ext.personalDashboard.common",
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"codexComponents": [
				"CdxButton",
				"CdxCard",
				"CdxDialog",
				"CdxIcon",
				"CdxMenuButton",
				"CdxPopover",
				"CdxProgressBar"
			],
			"dependencies": [
				"vue",
				"mediawiki.api",
				"mediawiki.DateFormatter"
			],
			"messages": [
				"personal-dashboard-multi-step-dialog-progress",
				"personal-dashboard-multi-step-dialog-next-button",
				"personal-dashboard-multi-step-dialog-previous-button",
				"personal-dashboard-multi-step-dialog-got-it-button",
				"personal-dashboard-feed-error",
				"personal-dashboard-feed-incomplete",
				"personal-dashboard-feed-load-more",
				"personal-dashboard-feed-loading-more",
				"personal-dashboard-feed-show-less"
			],
			"packageFiles": [
				"index.js",
				"constants.js",
				"experiments.js",
				"fetchFeed.js",
				"utils.js",
				"components/FeedCard.vue",
				"components/FeedPanel.vue",
				"components/ModuleHeaderMenu.vue",
				"components/ModulePanel.vue",
				"components/MultiStepDialog.vue",
				"composables/useFeedState.js",
				"composables/useViewport.js",
				"stats.js",
				{
					"name": "icons.json",
					"callback": "MediaWiki\\ResourceLoader\\CodexModule::getIcons",
					"callbackParam": [
						"cdxIconClose",
						"cdxIconCollapse",
						"cdxIconEllipsis",
						"cdxIconNext",
						"cdxIconPrevious"
					]
				}
			]
		},
		"ext.personalDashboard.styles": {
			"localBasePath": "resources/ext.personalDashboard.styles",
			"remoteExtPath": "PersonalDashboard/resources/personalDashboard.styles",
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"codexStyleOnly": true,
			"codexComponents": [
				"CdxButton",
				"CdxCard",
				"CdxInfoChip",
				"CdxMessage",
				"CdxProgressBar",
				"CdxThumbnail"
			],
			"styles": [
				"index.less"
			],
			"skinStyles": {
				"vector-2022": "skinStyles/vector-2022.less",
				"vector": "skinStyles/vector.less",
				"monobook": "skinStyles/monobook.less"
			}
		}
	},
	"ForeignResourcesDir": "resources/lib",
	"config": {
		"PersonalDashboardDeveloperSetup": {
			"description": "Catch fewer errors for easier troubleshooting",
			"value": false
		},
		"PersonalDashboardReviewChangesMlModel": {
			"description": "Machine learning model used to score revisions for the review changes module",
			"value": "revertrisklanguageagnostic"
		},
		"PersonalDashboardActiveDiscussionsPages": {
			"description": "The pages were active discussions will be extracted from",
			"value": []
		},
		"PersonalDashboardAllowOverride": {
			"description": "Kill switch for the pdo ModuleGroup override. False by default (safe for any install); WMF's deployment config sets this true for WMF wikis.",
			"value": false
		}
	},
	"DatabaseVirtualDomains": [
		"virtual-dashboard"
	],
	"attributes": {
		"PersonalDashboard": {
			"FeedSources": {
				"activediscussions": {
					"class": "MediaWiki\\Extension\\PersonalDashboard\\Feed\\Source\\ActiveDiscussionsFeedSource",
					"services": [
						"MainConfig",
						"PageStore",
						"PersonalDashboardDiscussionThreadLookup",
						"PersonalDashboardLogger"
					]
				},
				"mostedited": {
					"class": "MediaWiki\\Extension\\PersonalDashboard\\Feed\\Source\\MostEditedFeedSource",
					"services": [
						"ChangesListQueryFactory",
						"ConnectionProvider",
						"RowCommentFormatter",
						"MainConfig",
						"PersonalDashboardRevisionScoreLookup",
						"PersonalDashboardPageDescriptionLookup",
						"ActorNormalization",
						"SearchEngineFactory",
						"WANObjectCache",
						"ExtensionRegistry"
					]
				},
				"recentchanges": {
					"class": "MediaWiki\\Extension\\PersonalDashboard\\Feed\\Source\\RecentChangesFeedSource",
					"services": [
						"ChangesListQueryFactory",
						"ConnectionProvider",
						"RowCommentFormatter",
						"MainConfig",
						"PersonalDashboardRevisionScoreLookup",
						"PersonalDashboardPageDescriptionLookup"
					]
				},
				"recentlyedited": {
					"class": "MediaWiki\\Extension\\PersonalDashboard\\Feed\\Source\\RecentlyEditedFeedSource",
					"services": [
						"ChangesListQueryFactory",
						"ConnectionProvider",
						"RowCommentFormatter",
						"MainConfig",
						"PersonalDashboardRevisionScoreLookup",
						"PersonalDashboardPageDescriptionLookup",
						"ActorNormalization"
					]
				},
				"watchlist": {
					"class": "MediaWiki\\Extension\\PersonalDashboard\\Feed\\Source\\WatchlistFeedSource",
					"services": [
						"ChangesListQueryFactory",
						"ConnectionProvider",
						"RowCommentFormatter",
						"MainConfig",
						"PersonalDashboardRevisionScoreLookup",
						"PersonalDashboardPageDescriptionLookup"
					]
				}
			},
			"Modules": {
				"ext.personalDashboard.placeholder": {
					"class": "MediaWiki\\Extension\\PersonalDashboard\\Modules\\Placeholder"
				}
			},
			"ModuleGroups": {
				"null": {
					"description": "Null module test",
					"version": 0,
					"groups": [
						{
							"name": "main",
							"enabled": true,
							"subgroups": [
								{
									"name": "primary",
									"enabled": true,
									"modules": [
										{
											"name": "ext.personalDashboard.example",
											"enabled": true
										}
									]
								}
							]
						}
					]
				}
			}
		}
	},
	"manifest_version": 2
}
