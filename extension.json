{
	"name": "PersonalDashboard",
	"author": [
		"Jason Sherman",
		"[https://www.mediawiki.org/wiki/Growth/Team WMF Growth Team]"
	],
	"url": "https://www.mediawiki.org/wiki/Special:MyLanguage/Extension:PersonalDashboard",
	"descriptionmsg": "personal-dashboard-desc",
	"license-name": "GPL-3.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.47.0",
		"extensions": {
			"CommunityConfiguration": "*"
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\PersonalDashboard\\": "src/"
	},
	"ServiceWiringFiles": [
		"ServiceWiring.php"
	],
	"SpecialPages": {
		"PersonalDashboard": {
			"class": "MediaWiki\\Extension\\PersonalDashboard\\Specials\\SpecialPersonalDashboard",
			"services": [
				"PersonalDashboardModuleFactory",
				"StatsFactory"
			],
			"optional_services": [
				"TestKitchen.ExperimentManager"
			]
		}
	},
	"ConfigRegistry": {
		"PersonalDashboard": "MediaWiki\\Config\\GlobalVarConfig::newInstance"
	},
	"DefaultUserOptions": {
		"personaldashboard-eligible": false,
		"personaldashboard-visited": false
	},
	"HookHandlers": {
		"skintemplatenav-universal": {
			"class": "MediaWiki\\Extension\\PersonalDashboard\\HookHandler\\SkinTemplateNavigationUniversalHandler",
			"services": [
				"SpecialPageFactory",
				"UserOptionsManager",
				"UserEditTracker"
			]
		},
		"preferences": {
			"class": "MediaWiki\\Extension\\PersonalDashboard\\HookHandler\\GetPreferencesHandler"
		},
		"modules": {
			"class": "MediaWiki\\Extension\\PersonalDashboard\\HookHandler\\ResourceLoaderRegisterModulesHandler"
		}
	},
	"Hooks": {
		"GetPreferences": "preferences",
		"SkinTemplateNavigation::Universal": "skintemplatenav-universal",
		"ResourceLoaderRegisterModules": "modules"
	},
	"MessagesDirs": {
		"PersonalDashboard": [
			"i18n/ext.personalDashboard.activeDiscussions",
			"i18n/ext.personalDashboard.common",
			"i18n/ext.personalDashboard.impact",
			"i18n/ext.personalDashboard.onboarding",
			"i18n/ext.personalDashboard.policiesGuidelines",
			"i18n/ext.personalDashboard.reviewChanges",
			"i18n/ext.personalDashboard.reviewChanges.mobile",
			"i18n/main"
		]
	},
	"ExtensionMessagesFiles": {
		"PersonalDashboardAlias": "PersonalDashboard.i18n.alias.php"
	},
	"ResourceModules": {
		"ext.personalDashboard.menuIcon": {
			"class": "MediaWiki\\ResourceLoader\\OOUIIconPackModule",
			"selectorWithVariant": ".vector-icon.mw-ui-icon-wikimedia-{name}-{variant}",
			"selectorWithoutVariant": ".vector-icon.mw-ui-icon-wikimedia-{name}, .minerva-icon--{name}",
			"useMaskImage": true,
			"icons": [
				"viewCompact"
			]
		},
		"ext.personalDashboard.blueDot": {
			"localBasePath": "resources/ext.personalDashboard.blueDot",
			"dependencies": [
				"mediawiki.pulsatingdot"
			],
			"packageFiles": [
				"index.js"
			],
			"styles": [
				"dots.less"
			]
		},
		"ext.personalDashboard.special": {
			"localBasePath": "resources/ext.personalDashboard.special",
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"codexComponents": [
				"CdxButton",
				"CdxDialog",
				"CdxIcon"
			],
			"packageFiles": [
				"init.js",
				"App.vue",
				"Dashboard.vue",
				"FocusedFrame.vue",
				"FocusedHeader.vue",
				"IslandMount.vue",
				"ModuleDialog.vue",
				"mediaWikiHistory.js",
				"teleportTargets.js",
				"useViewport.js",
				"instrumentation/onPersonalDashboardBaseline.js",
				"instrumentation/experiments.js",
				{
					"name": "icons.json",
					"callback": "MediaWiki\\ResourceLoader\\CodexModule::getIcons",
					"callbackParam": [
						"cdxIconArrowPrevious"
					]
				}
			],
			"dependencies": [
				"vue",
				"vue-router",
				"pinia"
			],
			"messages": [
				"personal-dashboard-back-to-dashboard"
			]
		},
		"ext.personalDashboard.common": {
			"localBasePath": "resources/ext.personalDashboard.common",
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"codexComponents": [
				"CdxButton",
				"CdxDialog",
				"CdxIcon"
			],
			"dependencies": [
				"vue"
			],
			"messages": [
				"personal-dashboard-multi-step-dialog-progress",
				"personal-dashboard-multi-step-dialog-next-button",
				"personal-dashboard-multi-step-dialog-previous-button",
				"personal-dashboard-multi-step-dialog-got-it-button"
			],
			"packageFiles": [
				"index.js",
				"utils.js",
				"components/MultiStepDialog.vue",
				{
					"name": "icons.json",
					"callback": "MediaWiki\\ResourceLoader\\CodexModule::getIcons",
					"callbackParam": [
						"cdxIconClose",
						"cdxIconNext",
						"cdxIconPrevious"
					]
				}
			]
		},
		"ext.personalDashboard.onboarding": {
			"localBasePath": "resources/ext.personalDashboard.onboarding",
			"dependencies": [
				"vue",
				"ext.personalDashboard.common"
			],
			"messages": [
				"personal-dashboard-onboarding-title",
				"personal-dashboard-onboarding-dont-show-again",
				"personal-dashboard-onboarding-get-started-button",
				"personal-dashboard-onboarding-step-1-body",
				"personal-dashboard-onboarding-step-1-alt",
				"personal-dashboard-onboarding-step-2-title",
				"personal-dashboard-onboarding-step-3-title",
				"personal-dashboard-onboarding-step-3-body",
				"personal-dashboard-onboarding-step-3-alt"
			],
			"packageFiles": [
				"App.vue"
			]
		},
		"ext.personalDashboard.impact": {
			"localBasePath": "resources/ext.personalDashboard.impact",
			"remoteExtPath": "PersonalDashboard/resources/personalDashboard.impact",
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"codexComponents": [
				"CdxButton",
				"CdxIcon",
				"CdxPopover"
			],
			"dependencies": [
				"vue"
			],
			"messages": [
				"personal-dashboard-impact-thanks-sent",
				"personal-dashboard-impact-edits-reviewed",
				"personal-dashboard-impact-edits-reviewed-description",
				"personal-dashboard-impact-info-button"
			],
			"packageFiles": [
				"App.vue",
				{
					"name": "icons.json",
					"callback": "MediaWiki\\ResourceLoader\\CodexModule::getIcons",
					"callbackParam": [
						"cdxIconCheckAll",
						"cdxIconInfo",
						"cdxIconInfoFilled",
						"cdxIconUserTalk"
					]
				}
			]
		},
		"ext.personalDashboard.reviewChanges": {
			"localBasePath": "resources/ext.personalDashboard.reviewChanges",
			"remoteExtPath": "PersonalDashboard/resources/personalDashboard.reviewChanges",
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"codexComponents": [
				"CdxButton",
				"CdxCard",
				"CdxIcon",
				"CdxInfoChip",
				"CdxProgressBar"
			],
			"packageFiles": [
				"App.vue",
				"components/ListCard.vue",
				"store/reviewChangesStore.js",
				"composables/useWatchlistFeed.js",
				"composables/useRecentChangesFeed.js",
				"composables/useRecentlyEditedFeed.js",
				"utils/feedHelpers.js",
				{
					"name": "icons.json",
					"callback": "MediaWiki\\ResourceLoader\\CodexModule::getIcons",
					"callbackParam": [
						"cdxIconArticle",
						"cdxIconEdit",
						"cdxIconNotice",
						"cdxIconUserAvatar",
						"cdxIconUserTemporary",
						"cdxIconTextSummary",
						"cdxIconInfoFilled"
					]
				}
			],
			"messages": [
				"personal-dashboard-review-changes-major-changes-label",
				"personal-dashboard-risky-article-edits-header",
				"personal-dashboard-risky-article-edits-subheader",
				"personal-dashboard-risky-article-edits-footer-preamble",
				"personal-dashboard-risky-article-edits-info-time-text-today",
				"personal-dashboard-risky-article-edits-list-card-aria-label",
				"personal-dashboard-risky-article-edits-list-card-no-comment-message",
				"personal-dashboard-risky-article-edits-mobile-summary-footer-link-text",
				"personal-dashboard-risky-article-edits-mobile-user-text",
				"personal-dashboard-risky-article-edits-subheader-info",
				"tag-mw-reverted",
				"tag-mw-rollback",
				"tag-mw-replace",
				"tag-mw-manual-revert"
			],
			"dependencies": [
				"vue",
				"pinia",
				"mediawiki.DateFormatter",
				"ext.personalDashboard.common"
			]
		},
		"ext.personalDashboard.activeDiscussions": {
			"localBasePath": "resources/ext.personalDashboard.activeDiscussions",
			"remoteExtPath": "PersonalDashboard/resources/personalDashboard.activeDiscussions",
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"codexComponents": [
				"CdxCard",
				"CdxIcon",
				"CdxButton",
				"CdxProgressBar"
			],
			"packageFiles": [
				"App.vue",
				"components/ListCard.vue",
				"components/ListCardMobile.vue",
				"composables/useFetchActiveDiscussionsResult.js",
				{
					"name": "icons.json",
					"callback": "MediaWiki\\ResourceLoader\\CodexModule::getIcons",
					"callbackParam": [
						"cdxIconUserAvatar",
						"cdxIconSpeechBubble",
						"cdxIconSpeechBubbles"
					]
				}
			],
			"messages": [
				"personal-dashboard-active-discussions-title",
				"personal-dashboard-active-discussions-description",
				"personal-dashboard-active-discussions-latest-comment",
				"personal-dashboard-active-discussions-today",
				"personal-dashboard-active-discussions-mobile-summary-footer-link-text",
				"personal-dashboard-active-discussions-mobile-latest-comment",
				"personal-dashboard-active-discussions-mobile-today",
				"personal-dashboard-active-discussions-mobile-summary-footer-button-aria-label",
				"personal-dashboard-active-discussions-progress-bar-aria-label"
			],
			"dependencies": [
				"vue",
				"mediawiki.DateFormatter",
				"ext.personalDashboard.common"
			]
		},
		"ext.personalDashboard.styles": {
			"localBasePath": "resources/ext.personalDashboard.styles",
			"remoteExtPath": "PersonalDashboard/resources/personalDashboard.styles",
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"codexStyleOnly": true,
			"codexComponents": [
				"CdxInfoChip",
				"CdxMessage"
			],
			"styles": [
				"index.less"
			],
			"skinStyles": {
				"vector-2022": "skinStyles/vector-2022.less",
				"vector": "skinStyles/vector.less",
				"monobook": "skinStyles/monobook.less"
			}
		},
		"ext.personalDashboard.policiesGuidelines.styles": {
			"localBasePath": "resources/ext.personalDashboard.policiesGuidelines.styles",
			"remoteExtPath": "PersonalDashboard/resources/personalDashboard.policiesGuidelines.styles",
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"codexStyleOnly": true,
			"codexComponents": [
				"CdxAccordion"
			],
			"styles": [
				"index.less"
			]
		}
	},
	"ForeignResourcesDir": "resources/lib",
	"config": {
		"PersonalDashboardDeveloperSetup": {
			"description": "Catch fewer errors for easier troubleshooting",
			"value": false
		},
		"PersonalDashboardSurveyLink": {
			"description": "External link to the Personal Dashboard feedback survey.",
			"value": null
		},
		"PersonalDashboardUserMenu": {
			"description": "Show a link to the Personal Dashboard in the user menu.",
			"value": true
		},
		"PersonalDashboardMinimumEdits": {
			"description": "The minimum number of edits required to show the menu link. This has no effect if `$wgPersonalDashboardUserMenu = false`.",
			"value": 0
		},
		"PersonalDashboardMaximumEdits": {
			"description": "The maximum number of edits required to show the menu link. This has no effect if `$wgPersonalDashboardUserMenu = false`",
			"value": 0
		},
		"PersonalDashboardBlueDot": {
			"description": "Show a blue dot inviting users to try out the dashboard. This has no effect if `$wgPersonalDashboardUserMenu = false` or a user does not meet the `$wgPersonalDashboardMinimum/MaximumEdits` threshold.",
			"value": true
		},
		"PersonalDashboardReviewChangesMlModel": {
			"description": "ML model used to filter edits",
			"value": "revertrisklanguageagnostic"
		},
		"PersonalDashboardReviewChangesMinimumEditCount": {
			"description": "Minimum edit count required to view the review changes module",
			"value": 0
		},
		"PersonalDashboardActiveDiscussionsPages": {
			"description": "The pages were active discussions will be extracted from",
			"value": []
		}
	},
	"DatabaseVirtualDomains": [
		"virtual-dashboard"
	],
	"attributes": {
		"PersonalDashboard": {
			"Modules": {
				"ext.personalDashboard.activeDiscussions": {
					"class": "MediaWiki\\Extension\\PersonalDashboard\\Modules\\ActiveDiscussions"
				},
				"ext.personalDashboard.banner": {
					"class": "MediaWiki\\Extension\\PersonalDashboard\\Modules\\Banner"
				},
				"ext.personalDashboard.impact": {
					"class": "MediaWiki\\Extension\\PersonalDashboard\\Modules\\Impact",
					"services": [
						"ConnectionProvider"
					]
				},
				"ext.personalDashboard.placeholder": {
					"class": "MediaWiki\\Extension\\PersonalDashboard\\Modules\\Placeholder"
				},
				"ext.personalDashboard.onboarding": {
					"class": "MediaWiki\\Extension\\PersonalDashboard\\Modules\\Onboarding",
					"services": [
						"UserOptionsManager"
					]
				},
				"ext.personalDashboard.policiesGuidelines": {
					"class": "MediaWiki\\Extension\\PersonalDashboard\\Modules\\PoliciesGuidelines"
				},
				"ext.personalDashboard.returnToHomepage": {
					"class": "MediaWiki\\Extension\\PersonalDashboard\\Modules\\ReturnToHomepage"
				},
				"ext.personalDashboard.reviewChanges": {
					"class": "MediaWiki\\Extension\\PersonalDashboard\\Modules\\ReviewChanges",
					"services": [
						"ConnectionProvider",
						"ChangesListQueryFactory",
						"CommentFormatter"
					]
				}
			},
			"ModuleGroups": {
				"default": {
					"description": "The Moderator Tools default Personal Dashboard experience",
					"version": 0,
					"groups": [
						{
							"name": "utils",
							"enabled": true,
							"hidden": true,
							"subgroups": [
								{
									"name": "startup",
									"enabled": true,
									"modules": [
										{
											"name": "ext.personalDashboard.onboarding",
											"enabled": true
										}
									]
								}
							]
						},
						{
							"name": "main",
							"enabled": true,
							"subgroups": [
								{
									"name": "primary",
									"enabled": true,
									"modules": [
										{
											"name": "ext.personalDashboard.banner",
											"enabled": true
										},
										{
											"name": "ext.personalDashboard.reviewChanges",
											"enabled": true,
											"style": "thin"
										},
										{
											"name": "ext.personalDashboard.activeDiscussions",
											"enabled": true,
											"style": "thin"
										}
									]
								}
							]
						},
						{
							"name": "sidebar",
							"enabled": true,
							"subgroups": [
								{
									"name": "primary",
									"enabled": true,
									"modules": [
										{
											"name": "ext.personalDashboard.impact",
											"enabled": true
										}
									]
								},
								{
									"name": "secondary",
									"enabled": true,
									"modules": [
										{
											"name": "ext.personalDashboard.policiesGuidelines",
											"enabled": true
										}
									]
								}
							]
						}
					]
				},
				"null": {
					"description": "Null module test",
					"version": 0,
					"groups": [
						{
							"name": "main",
							"enabled": true,
							"subgroups": [
								{
									"name": "primary",
									"enabled": true,
									"modules": [
										{
											"name": "ext.personalDashboard.example",
